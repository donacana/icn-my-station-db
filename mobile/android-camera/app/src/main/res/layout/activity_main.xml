<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- 1. 카메라 실시간 미리보기 (전체 화면 - 카메라 변경 시에도 항상 유지) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- 2. 상단 상태 헤더 영역 (반투명 오버레이) -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        app:layout_constraintWidth_max="640dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 연결 상태 뱃지 (도트 + 텍스트) -->
            <LinearLayout
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/ic_status_dot" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 설정 토글 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="#66FFFFFF" />
        </LinearLayout>

        <!-- 실시간 송출 지표 카드 (현재 선택된 카메라명, FPS, Frame ID, Sent, Dropped) -->
        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stats_card"
            android:orientation="vertical">

            <!-- 선택된 카메라 표시 레이블 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentCameraBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[카메라 1: T1 3번 출국장]"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSpecs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_specs"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLiveFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FPS: 0.0 / 3.0"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvFrameStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frame: - | 전송: 0 | 폐기: 0"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 서버 주소, 카메라 선택, 토큰 설정 패널 (접이식 오버레이, 가로 모드 스크롤 최적화) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/overlay_panel"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomControlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOLO DEMO 설정 (v0.4)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 카메라 선택 섹션 (요구사항 1 & 2) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_camera_select"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgCameraSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbCamera1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/camera_1_title"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbCamera2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_2_title"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbCameraCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_custom_title"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </RadioGroup>

                <!-- 카메라 ID 직접 입력 (RDS 등록값 수정 지원, 요구사항 2) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCameraId"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/label_camera_id"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCameraId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 서버 URL 입력 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilServerUrl"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/label_server_url"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="ws://&lt;SERVER_HOST&gt;/ws/yolo/camera" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 인증 토큰 입력 (YOLO_CAMERA_TOKEN) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCameraToken"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/label_camera_token"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCameraToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="token" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 저장 및 즉시 재연결 버튼 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/action_save_settings"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- 4. 하단 제어 버튼 영역 (송출 시작 / 중지, 가로 모드 최적화) -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        app:layout_constraintWidth_max="480dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 송출 시작 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartStream"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/btn_start"
            android:text="@string/action_start_stream"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary" />

        <!-- 송출 중지 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopStream"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/btn_stop"
            android:enabled="false"
            android:text="@string/action_stop_stream"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary" />
    </LinearLayout>

    <!-- 5. 카메라 권한 필요 시 안내 오버레이 -->
    <LinearLayout
        android:id="@+id/permissionOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/permission_camera_rationale"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/action_grant_permission"
            android:textColor="@color/text_primary"
            app:cornerRadius="20dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
