# Copy to .env.ec2, then insert the real token locally. Never commit .env.ec2.
YOLO_PROTOCOL=demo-v0.4
CAMERA_ID=1
CAMERA_IDS=1,2
WORKER_ID=suam-school-pc
WORKER_MODEL_VERSION=icn-v1-yolo11n-finger-gun
WS_URL=wss://replace-with-public-host/ws/yolo/worker
YOLO_WORKER_TOKEN=
MOCK_MODE=false
ALLOW_REMOTE_EC2=true
ALLOW_DEMO_MODEL_FALLBACK=false
INFERENCE_BACKEND=onnx_cpu
ONNX_MODEL_PATH=models/best.onnx
YOLO_IMGSZ=416
YOLO_MAX_FPS=3
ENABLE_TRACKING=true
ENABLE_GESTURE=true
PERSON_CONF=0.25
GESTURE_CONF=0.6
GESTURE_COOLDOWN_SECONDS=10
LOG_RESULT_SUMMARY=true
MAX_FRAME_AGE_SECONDS=5
