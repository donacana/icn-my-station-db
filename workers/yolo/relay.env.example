# Local YOLO DEMO v0.3 only. 1 is a test ID, not a confirmed DB ID.
YOLO_PROTOCOL=demo-v0.3
CAMERA_ID=1
RELAY_CAMERA_ID=1
WORKER_ID=icn-windows-worker
WS_URL=ws://127.0.0.1:8000/ws/yolo/worker
YOLO_WORKER_TOKEN=local-worker-demo
YOLO_CAMERA_TOKEN=local-camera-demo
MOCK_MODE=true
INFERENCE_BACKEND=onnx_cpu
ONNX_MODEL_PATH=models/best.onnx
YOLO_IMGSZ=416
YOLO_MAX_FPS=3
