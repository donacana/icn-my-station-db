# Legacy mock-v1 settings. For deployed YOLO DEMO v0.4 copy ec2.env.example separately.
INFERENCE_BACKEND=onnx_cpu
ONNX_MODEL_PATH=models/best.onnx
TORCH_MODEL_PATH=models/best.pt
# CLASS_MAP_PATH=models/data.yaml
CAMERA_ID=DEMO_T1_3
# v0.4 integer camera example: CAMERA_ID=1 and CAMERA_IDS=1,2
WS_URL=ws://127.0.0.1:8765/ws/yolo/worker
WS_TOKEN=
YOLO_CONF=0.35
PERSON_CONF=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=416
YOLO_MAX_FPS=3
ONNX_INTRA_OP_THREADS=4
ONNX_INTER_OP_THREADS=1
ENABLE_TRACKING=true
ENABLE_GESTURE=true
GESTURE_WINDOW_SECONDS=2
GESTURE_COOLDOWN_SECONDS=30
GESTURE_CONF=0.6
GESTURE_OPEN_CLASS=help_open
GESTURE_FIST_CLASS=help_fist
MOCK_MODE=true
ALLOW_CUDA_AUTO=false
CUDA_MIN_FREE_MB=512
MAX_FRAME_AGE_SECONDS=5
OFFLINE_SECONDS=10
LOG_RESULT_SUMMARY=false
